[Desktop Entry]
# Handlebars template for the .deb/.rpm/.AppImage desktop entry
# (bundle.linux.{deb,rpm}.desktopTemplate). Available variables:
# `categories`, `comment`, `exec`, `icon`, `mime_type`, `name`.
#
# Two lines differ from Tauri's built-in template, and both are required for
# "Open With → OMP Desktop" on a folder:
#
#   * `MimeType=inode/directory` — what makes file managers list the app for
#     a directory. `bundle.fileAssociations` cannot express it: `ext` is
#     required there and a folder has no extension. The `{{mime_type}}` half
#     is Tauri's own list (file associations + deep-link schemes) and must
#     stay, or those would register everywhere except Linux.
#   * `%F` on Exec — the built-in template has a bare `Exec={{exec}}`, so the
#     selected folder would never reach the process. It arrives as argv; see
#     src-tauri/src/external_open.rs.
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %F
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
MimeType=inode/directory;{{#if mime_type}}{{mime_type}};{{/if}}
