<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged into the bundle's generated Info.plist (bundle.macOS.infoPlist).

  Declares OMP Desktop as an opener for directories, which is what puts it in
  Finder's "Open With" menu for a folder. LaunchServices then delivers the
  selection as a `file://` URL through `tauri::RunEvent::Opened` — see
  src-tauri/src/external_open.rs.

  LSHandlerRank=Alternate deliberately: the default handler for a folder must
  stay Finder itself.

  Not expressible through `bundle.fileAssociations`, which is keyed by file
  extension (`ext` is required) and a folder has none.

  NSLocalNetworkUsageDescription: macOS Local Network Privacy attributes the
  connections of every process the app starts (omp, kubectl, MCP servers,
  widget plugins) to OMP Desktop. Without a usage description macOS never asks
  and drops their LAN connections silently (kernel log: `tcp drop outgoing …
  reason: NECP`), even with the app switched on under Local Network.

  NSMicrophoneUsageDescription: omp captures voice conversations and dictation
  in a child process; macOS attributes its microphone request to this app bundle.
  The hardened-runtime audio-input entitlement is in Entitlements.plist.
-->
<plist version="1.0">
<dict>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Folder</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.folder</string>
      </array>
    </dict>
  </array>
  <key>NSLocalNetworkUsageDescription</key>
  <string>OMP Desktop and the agents, tools and widgets it starts connect to services on your local network, such as Kubernetes clusters.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>OMP Desktop uses your microphone for live conversations and voice-to-text dictation.</string>
</dict>
</plist>
